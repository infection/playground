{
    "$schema": "./vendor/infection/infection/resources/schema.json",
    "timeout": 60,
    "source": {
        "directories": ["src"]
    },
    "mutators": {
        "@default": true,
        "global-ignoreSourceCodeByRegex": [
            // clearing the entity manager only frees memory: no test can see it
            "\\$this->entityManager->clear\\(\\);",
        ],
        "PublicVisibility": {
            // the getters and setters of the Doctrine entities: making them protected is not worth a test
            "ignore": [
                "App\\Entity\\*::get*",
                "App\\Entity\\*::set*",
                "App\\Entity\\*::is*",
                "App\\Entity\\*::has*",
                // Symfony calls the controller actions, so the coverage never sees the line of their signature
                "App\\Controller\\*",
            ],
        },
    },
    "logs": {
        "text": "var/infection.log"
    }
}
