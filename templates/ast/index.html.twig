{% extends 'base.html.twig' %}

{% block title %}AST Explorer · Infection Playground{% endblock %}

{% block body_class %}workbench-page{% endblock %}

{% block body %}
    <main id="ast-app"
         class="ast"
         data-base-url="{{ path('app_ast_index') }}"
         data-xray-endpoint="{{ path('app_ast_xray') }}"
         data-share-endpoint="{{ path('app_ast_share') }}">
        <script type="application/json" id="ast-initial">{{ {code: code, idHash: idHash, activeNodeId: activeNodeId, xray: xray}|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP'))|raw }}</script>

        <section class="pane" aria-label="PHP code with AST X-Ray">
            <div class="pane-h">
                <span class="tab static">
                    <svg class="file-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m8 7-5 5 5 5M16 7l5 5-5 5"/></svg>
                    <span class="mono">PHP code</span>
                </span>
                <span class="pane-meta">Hover over the code to inspect a node, click to pin it</span>
            </div>
            <div id="editor-code-ast" class="ed"></div>
            <div id="xray-status" class="xray-status">Building AST…</div>
        </section>

        <div class="gutter gutter-x" data-split="ast" role="separator" aria-orientation="vertical" aria-label="Resize the code and node details panes" aria-valuemin="15" aria-valuemax="85" tabindex="0" title="Drag to resize, double-click to reset"></div>

        <section class="pane" aria-label="Node details">
            <div class="pane-h">
                <span class="tab static">Node details</span>
                <span class="pane-meta">
                    <button id="ast-share" type="button" class="btn btn-sm">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg>
                        <span id="ast-share-label">Share</span>
                    </button>
                </span>
            </div>
            <div class="ast-side">
                <div id="ast-details" class="ast-details"></div>
                <p class="credit">
                    AST X-Ray is ported from <a href="https://phpstan.org/try" target="_blank" rel="noopener">PHPStan's playground</a>
                    (<a href="https://github.com/phpstan/phpstan/blob/HEAD/LICENSE" target="_blank" rel="noopener">MIT license</a>).
                </p>
            </div>
        </section>
    </main>
{% endblock %}

{% block importmap %}{{ importmap('ast') }}{% endblock %}
