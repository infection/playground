{% extends 'base.html.twig' %}

{% block title %}Infection Playground{% endblock %}

{% block body %}
    {{ include('playground/_form.html.twig') }}

    {% if resultOutput is defined %}
        <div class="mt-6">
            <div class="terminal-window">
                <div class="terminal-header">
                    <div class="flex items-center gap-1.5">
                        <span class="w-3 h-3 rounded-full bg-red-400"></span>
                        <span class="w-3 h-3 rounded-full bg-yellow-400"></span>
                        <span class="w-3 h-3 rounded-full bg-green-400"></span>
                    </div>
                    <span class="text-xs font-medium text-gray-500 dark:text-gray-400">Output</span>
                    <div class="w-12"></div>
                </div>
                <pre class="terminal-body ansi-theme-container">{{ resultOutput|raw }}</pre>
            </div>
        </div>
    {% endif %}

    {% if jsonLog is defined and jsonLog is not empty %}
        <div class="flex items-center py-6">
            <div class="flex-1 h-px bg-gradient-to-r from-transparent via-gray-300 dark:via-gray-700 to-transparent"></div>
            <span class="px-4 text-sm font-medium text-gray-400 dark:text-gray-500 uppercase tracking-wider">Generated Mutants</span>
            <div class="flex-1 h-px bg-gradient-to-r from-transparent via-gray-300 dark:via-gray-700 to-transparent"></div>
        </div>

        <div id="no-mutations-alert" class="hidden bg-yellow-50 dark:bg-yellow-900/30 border border-yellow-200 dark:border-yellow-700/50 text-yellow-700 dark:text-yellow-300 px-4 py-3 rounded-lg text-sm" role="alert">
            No mutants were generated for provided code and config file.
        </div>
        <div id="mutants-log" class="pb-6">
            <div class="flex flex-col lg:flex-row gap-3">
                <div class="w-full lg:w-1/3 mutant-list-panel" style="height: 300px; overflow-y: auto;">
                    <table id="mutants-table" class="w-full">
                        <tbody>
                        </tbody>
                    </table>
                </div>
                <div class="w-full lg:w-1/3">
                    <div id="editor-diff" class="rounded-lg overflow-hidden border border-gray-200 dark:border-gray-700/50" style="height: 300px;"></div>
                </div>
                <div class="w-full lg:w-1/3">
                    <pre id="mutant-output" class="terminal-body text-sm" style="height: 300px; overflow: auto;"></pre>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('app') }}
{% endblock %}
