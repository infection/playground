{% extends 'base.html.twig' %}

{# the versions of this run, or of a new one: in the top bar, and in the menu on narrow screens #}
{% set infectionVersion = example.infectionVersion ?? constant('App\\Infection\\Runner::CURRENT_INFECTION_VERSION') %}
{% set phpunitVersion = example.phpunitVersion ?? constant('App\\Infection\\Runner::CURRENT_PHPUNIT_VERSION') %}
{% set phpVersion = example.phpVersion ?? constant('App\\Infection\\Runner::CURRENT_PHP_VERSION') %}

{% block title %}{{ example.title ?? false ? example.title ~ ' · ' : '' }}Infection Playground{% endblock %}

{% block body_class %}workbench-page{% endblock %}

{# outside the form element, so it joins the form by its id #}
{% block topbar_title %}
    {# TODO(explore): hidden until Explore is finished, uncomment to bring it back, and drop the setRendered call below
    <label class="run-title">
        <span class="sr-only">Title of the run, optional, shown in Explore</span>
        {{ form_widget(form.title, {attr: {form: 'workbench', placeholder: 'Untitled run', title: 'An optional title, shown in Explore'}}) }}
    </label>
    #}
    {# keeps form_end from rendering the hidden title inside the form #}
    {% do form.title.setRendered %}
{% endblock %}

{% block topbar_actions %}{{ include('playground/_topbar.html.twig') }}{% endblock %}

{% block menu_versions %}{{ include('playground/_menu_versions.html.twig') }}{% endblock %}

{% block body %}
    {{ include('playground/_form.html.twig') }}
{% endblock %}
