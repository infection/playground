{% if example is defined %}
    <div id="loaded-code" data-code="{{ example.code }}"></div>
    <div id="loaded-test" data-code="{{ example.test }}"></div>
    <div id="loaded-config" data-code="{{ example.config }}"></div>
{% endif %}

{% set hasRun = resultOutput is defined %}

{{ form_start(form, {attr: {class: 'ws', id: 'workbench', 'data-tab': hasRun ? 'results' : 'code'}}) }}
    <section class="pane p-source" aria-label="Source code">
        <div class="pane-h">
            <span class="tab static">
                <svg class="file-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m8 7-5 5 5 5M16 7l5 5-5 5"/></svg>
                <span class="mono">Source code</span>
            </span>
            <span class="pane-meta" id="source-meta"></span>
        </div>
        <div id="editor-code" class="ed"></div>
        <div class="hidden">{{ form_widget(form.code) }}</div>
    </section>

    <div class="gutter gutter-y" data-split="rows" role="separator" aria-orientation="horizontal" aria-label="Resize the source code and test panes" aria-valuemin="15" aria-valuemax="85" tabindex="0" title="Drag to resize, double-click to reset"></div>

    <section class="pane p-test" aria-label="Test and configuration">
        <div class="pane-h" role="tablist">
            <button class="tab" type="button" role="tab" data-side-tab="test" aria-selected="true" aria-controls="editor-test">
                <svg class="file-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="9"/></svg>
                <span class="mono">Test</span>
            </button>
            <button class="tab" type="button" role="tab" data-side-tab="config" aria-selected="false" aria-controls="editor-config">
                <svg class="file-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12"/><circle cx="16" cy="6" r="2"/><circle cx="10" cy="12" r="2"/><circle cx="18" cy="18" r="2"/></svg>
                <span class="mono">infection.json5</span>
            </button>
            <span class="pane-meta" id="side-meta">PHPUnit test case</span>
        </div>
        <div id="editor-test" class="ed" role="tabpanel"></div>
        <div id="editor-config" class="ed" role="tabpanel" hidden></div>
        <div class="hidden">{{ form_widget(form.test) }}{{ form_widget(form.config) }}</div>
    </section>

    <div class="gutter gutter-x" data-split="columns" role="separator" aria-orientation="vertical" aria-label="Resize the code and results columns" aria-valuemin="15" aria-valuemax="85" tabindex="0" title="Drag to resize, double-click to reset"></div>

    <section class="pane p-results" aria-label="Results">
        {{ include('playground/_results.html.twig') }}
    </section>

    <nav class="mtabs" role="tablist" aria-label="Section">
        <button type="button" role="tab" data-tab="code" aria-selected="{{ hasRun ? 'false' : 'true' }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m8 7-5 5 5 5M16 7l5 5-5 5"/></svg>
            Code
        </button>
        <button type="button" role="tab" data-tab="test" aria-selected="false">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="9"/></svg>
            Test
        </button>
        <button type="button" role="tab" data-tab="config" aria-selected="false">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12"/><circle cx="16" cy="6" r="2"/><circle cx="10" cy="12" r="2"/><circle cx="18" cy="18" r="2"/></svg>
            Config
        </button>
        <button type="button" role="tab" data-tab="results" aria-selected="{{ hasRun ? 'true' : 'false' }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>
            Results
            <span class="mtab-badge" id="mtab-badge" hidden></span>
        </button>
    </nav>

    <div class="hidden">{{ form_rest(form) }}</div>
{{ form_end(form) }}
