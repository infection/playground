{# Toolchain, Share and Run in the top bar of the playground pages #}
{# The versions open the toolchain of a new run. Its radios are fields of the form below the top bar: form="workbench" #}
{% set staticAnalysisTool = form.staticAnalysisTool %}
<div class="pop-wrap">
    <button class="btn env" id="toolchain-btn" type="button" title="{{ resultOutput is not null ? 'Tools this run used' : 'Tools a new run uses' }}" aria-controls="toolchain-pop" aria-expanded="false" data-popover>
        <svg class="env-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12"/><circle cx="16" cy="6" r="2"/><circle cx="10" cy="12" r="2"/><circle cx="18" cy="18" r="2"/></svg>
        <span class="sr-only">Toolchain:</span>
        <span class="env-versions">
            <span>Infection <b>{{ infectionVersion }}</b></span>
            <span>PHPUnit <b>{{ phpunitVersion }}</b></span>
            <span class="env-php">PHP <b>{{ phpVersion }}</b></span>
        </span>
        {% for tool in staticAnalysisTools %}
            <span class="env-sa" data-static-analysis-chip="{{ tool.value }}"{% if staticAnalysisTool.vars.value != tool.value %} hidden{% endif %}>
                {{ tool.label }} <b>{{ staticAnalysisToolVersion ?? tool.currentVersion }}</b>
            </span>
        {% endfor %}
    </button>
    <div class="pop toolchain" id="toolchain-pop" role="group" aria-label="Toolchain of a new run" hidden>
        <h4>Toolchain</h4>
        <p>The tools of the next run.</p>

        <div class="tc-group">
            {{ form_label(form.infectionCommitUrl, 'Infection', {label_attr: {class: 'tc-legend'}}) }}
            {{ form_widget(form.infectionCommitUrl, {attr: {
                form: 'workbench',
                class: 'tc-input',
                placeholder: 'Released ' ~ currentInfectionVersion ~ ', or a pull request link',
                autocomplete: 'off',
                spellcheck: 'false',
                'aria-describedby': 'infection-commit-hint',
                'aria-invalid': form.infectionCommitUrl.vars.errors is empty ? 'false' : 'true',
            }}) }}
            <p class="tc-hint" id="infection-commit-hint">To try a change to Infection, paste the link to a pull request of infection/infection, or to one of its commits. Pull requests from forks can't be run.</p>
        </div>

        <div class="tc-group">
            <div class="tc-legend">Test framework</div>
            <div class="tc-row">PHPUnit <span class="tc-ver">{{ currentPhpunitVersion }}</span></div>
        </div>

        <fieldset class="tc-group">
            <legend class="tc-legend">Static analysis</legend>
            {% for radio in staticAnalysisTool %}
                {% set tool = staticAnalysisTools[radio.vars.value] ?? null %}
                <label class="tc-row">
                    {{ form_widget(radio, {attr: {form: 'workbench'}}) }}
                    {{ tool.label ?? 'None' }}
                    {% if tool is not null %}<span class="tc-ver">{{ tool.currentVersion }}</span>{% endif %}
                </label>
            {% endfor %}
            <p class="tc-hint">Infection runs it on the mutants the tests let escape. A mutant it reports an error for counts as killed. <a href="https://infection.github.io/guide/static-analysis-integration.html" target="_blank" rel="noopener">How it works ↗</a></p>
        </fieldset>
    </div>
</div>

{% if resultOutput is not null %}
    <div class="pop-wrap">
        <button class="btn" id="share-btn" type="button" aria-label="Share this run" aria-controls="share-pop" aria-expanded="false" data-popover>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg>
            <span class="btn-label">Share</span>
        </button>
        <div class="pop" id="share-pop" role="group" aria-label="Link to this run" hidden>
            <h4>Link to this run</h4>
            <p>Opens the same code, test, config and results. Each run gets its own link.</p>
            <div class="share-row">
                <input id="share-url" type="text" readonly aria-label="Link to this run" value="{{ app.request?.uri }}">
                <button class="btn btn-sm" id="copy-url" type="button">Copy</button>
            </div>
        </div>
    </div>
{% endif %}

{# the same code, test, config, static analysis and versions open the same run: the button waits for a change, see watchForChangesSinceRun() in editor.js #}
{# a run of a commit of Infection is on the current version of it: the commit is in the toolchain #}
{% set isRunOnCurrentVersions = resultOutput is not null
    and example is not null
    and (example.infectionCommit is not null or infectionVersion == currentInfectionVersion)
    and phpunitVersion == currentPhpunitVersion
    and phpVersion == currentPhpVersion
    and (example.staticAnalysisTool is null or staticAnalysisToolVersion == example.staticAnalysisTool.currentVersion) %}
<button id="js-submit" class="btn btn-run" type="button" title="Run Infection (Ctrl/⌘ + Enter)"{% if isRunOnCurrentVersions %} data-run-on-current-versions{% endif %}>
    <svg class="run-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15a1 1 0 0 0 1.5.86l12.5-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5Z"/></svg>
    <span class="spin" aria-hidden="true"></span>
    <span class="run-label">Run</span><kbd>⌘↵</kbd>
</button>
