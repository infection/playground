parameters:
    level: max
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    excludePaths:
        - src/Html/Ansi/*
    ignoreErrors:
        - '#^Property App\\Entity\\(.*):\$id is never written, only read.$#'
        # Symfony's front controller: the runtime passes the environment as a string
        - identifier: argument.type
          path: public/index.php
