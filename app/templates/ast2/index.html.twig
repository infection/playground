{% extends 'base.html.twig' %}

{% block title %}AST X-Ray{% endblock %}

{% block body %}
    <div class="container w-full md:max-w-5xl mx-auto pb-4">
        <p class="py-6 dark:text-gray-200">
            <span class="font-bold">Hover</span> over the code to see its AST nodes. The AST is rebuilt as you type.
            <span class="text-green-600 dark:text-green-400">canMutate()</span> shows the node class to use in <code class="dark:bg-gray-700 dark:text-gray-200">Mutator::canMutate()</code>.
        </p>

        <div class="editor-panel">
            <div class="editor-panel-header">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                PHP Code
            </div>
            <div id="editor-code-ast2" data-endpoint="{{ path('app_ast2_xray') }}" style="height:600px;"></div>
            <div id="xray-status" class="xray-status">Building AST…</div>
        </div>

        <div class="flex w-full items-center font-light px-4 py-12">
            <div class="flex-1 px-2">
                <p class="text-gray-600 dark:text-gray-400 text-xs md:text-base">AST X-Ray is ported from <a class="text-green-500 dark:text-green-400 no-underline hover:underline" href="https://phpstan.org/try">PHPStan's playground</a> (MIT license)</p>
            </div>
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('ast2') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('ast2') }}
{% endblock %}
