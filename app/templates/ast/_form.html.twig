{% if astRun is defined %}
    <div id="loaded-code" data-code="{{ astRun.code }}"></div>
{% endif %}

{{ form_start(form) }}
    <div class="flex">
        <div class="flex-1 editor-panel">
            <div class="editor-panel-header">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                PHP Code
            </div>
            <div id="editor-code-ast" style="height:400px;"></div>
            <div class="hidden">{{ form_widget(form.code) }}</div>
            {{ form_errors(form.code) }}
        </div>
    </div>

    <div class="mt-4">
        <button id="js-submit" class="btn-primary" type="button">
            <svg class="w-4 h-4 mr-2" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M4 4l12 6-12 6z"/></svg>
            <span>{{ astRun is defined ? 'Rebuild' : 'Build' }} AST</span>
        </button>
    </div>
    <div class="hidden">{{ form_rest(form) }}</div>
{{ form_end(form) }}
