{% extends 'base.html.twig' %}

{% block title %}AST Explorer{% endblock %}

{% block body %}
    <div id="ast-app"
         class="container w-full md:max-w-5xl mx-auto pb-4"
         data-base-url="{{ path('app_ast_index') }}"
         data-xray-endpoint="{{ path('app_ast_xray') }}"
         data-share-endpoint="{{ path('app_ast_share') }}">
        <script type="application/json" id="ast-initial">{{ {code: code, idHash: idHash, activeNodeId: activeNodeId, xray: xray}|json_encode|raw }}</script>

        <p class="py-6 dark:text-gray-200">
            <span class="font-bold">Hover</span> over the code to see its AST nodes, <span class="font-bold">click</span> to pin a node and see the node to use in <code class="dark:bg-gray-700 dark:text-gray-200">Mutator::canMutate()</code>. The AST is rebuilt as you type.
        </p>

        <div class="editor-panel">
            <div class="editor-panel-header">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                PHP Code
                <button id="ast-share" type="button" class="ast-share-btn">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                    <span id="ast-share-label">Share</span>
                </button>
            </div>
            <div id="editor-code-ast" style="height:240px;"></div>
            <div id="xray-status" class="xray-status">Building AST…</div>
        </div>

        <div id="ast-details" class="ast-details"></div>

        <div class="flex w-full items-center font-light px-4 py-12">
            <div class="flex-1 px-2">
                <p class="text-gray-600 dark:text-gray-400 text-xs md:text-base">
                    AST X-Ray is ported from <a class="text-green-500 dark:text-green-400 no-underline hover:underline" href="https://phpstan.org/try">PHPStan's playground</a>
                    (<a class="text-green-500 dark:text-green-400 no-underline hover:underline" href="https://github.com/phpstan/phpstan/blob/HEAD/LICENSE">MIT license</a>).
                </p>
            </div>
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ encore_entry_link_tags('ast') }}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('ast') }}
{% endblock %}
